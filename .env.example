# ------------------------------------------------------------------
# PHINMA COC Multi-Event Tabulation System — environment settings
# Copy this file to .env and adjust for each server. Never commit .env.
# ------------------------------------------------------------------

APP_NAME="PHINMA COC Tabulation"
APP_SCHOOL="PHINMA Cagayan de Oro College"
APP_TIMEZONE=Asia/Manila
# Show detailed error messages in API responses (set false in production)
APP_DEBUG=true
# How often open pages check for changes (seconds). Use 15-20 on free hosting with a daily hit limit.
LIVE_UPDATE_SECONDS=4

# ---------------- Database (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=coc_tabulation
DB_USER=root
DB_PASS=

# ---------------- File server (all uploads go here)
# local : a folder on this machine OR a mounted/UNC network share,
#         e.g. STORAGE_LOCAL_PATH=\\FILESERVER\tabulation  or  D:/fileserver/tabulation
#         A relative path is resolved from the project folder.
# ftp   : a remote FTP/FTPS file server (e.g. FileZilla Server)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=storage/uploads

FTP_HOST=127.0.0.1
FTP_PORT=21
FTP_USER=
FTP_PASS=
FTP_ROOT=/tabulation
FTP_PASSIVE=true
FTP_SSL=false
FTP_TIMEOUT=20

# Maximum upload size in megabytes
UPLOAD_MAX_MB=15

# ---------------- Document scanning (OCR)
# Tesseract (local, free). Leave blank to auto-detect common install paths.
TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe
# Cloud fallback for scanned PDFs / when Tesseract is missing.
# "helloworld" is OCR.space's public demo key (1 MB limit). Get a free key: https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=helloworld

# ---------------- Security
# Failed sign-in attempts allowed per IP address within 10 minutes
MAX_LOGIN_ATTEMPTS=10
